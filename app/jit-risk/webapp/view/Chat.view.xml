<mvc:View
    controllerName="jit.risk.controller.Chat"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    displayBlock="true">
    <l:VerticalLayout class="sapUiContentPadding" width="100%">
        
        <!-- Chat Messages Area -->
        <Panel headerText="Chat Assistant" class="sapUiResponsiveMargin">
            <content>
                <ScrollContainer
                    id="chatScrollContainer"
                    height="500px"
                    width="100%"
                    vertical="true"
                    horizontal="false"
                    class="chatScrollContainer">
                    
                    <List
                        id="chatFeed"
                        items="{chatModel>/messages}"
                        showNoData="false"
                        class="chatFeedList">
                        <CustomListItem class="{= ${chatModel>sender} === 'user' ? 'chatMessageUser' : 'chatMessageBot' }">
                            <VBox class="chatBubbleContainer">
                                <HBox alignItems="Start" class="chatMessageBox">
                                    <VBox class="chatBubble {= ${chatModel>sender} === 'user' ? 'userBubble' : 'botBubble' }">
                                        <FormattedText
                                            htmlText="{chatModel>text}"
                                            class="chatMessageText"/>
                                        
                                        <!-- Button container - populated dynamically by controller -->
                                        <HBox class="chatButtonContainer" wrap="Wrap"/>
                                    </VBox>
                                </HBox>
                                <Text text="{chatModel>timestamp}" class="chatTimestamp"/>
                            </VBox>
                        </CustomListItem>
                    </List>
                </ScrollContainer>
                
                <!-- Input Area -->
                <!-- <Bar class="chatInputBar"> -->
                <HBox class="chatInputBar" alignItems="Center" width="100%">
                    <!-- <contentLeft> -->
                        <Input
                            id="chatInput"
                            placeholder="Type your message or select an action..."
                            
                            submit=".onSendMessage"
                            class="chatInputField"
                            >
                             <layoutData><FlexItemData growFactor="1"/></layoutData>
                             </Input>
                            
                    <!-- </contentLeft>
                    <contentRight> -->
                        <Button
                            icon="sap-icon://paper-plane"
                            text="Send"
                            type="Emphasized"
                            press=".onSendMessage"
                        class="chatSendButton"/>
                </HBox>
                    <!-- </contentRight> -->
                <!-- </Bar> -->
            </content>
        </Panel>

    </l:VerticalLayout>
</mvc:View>
