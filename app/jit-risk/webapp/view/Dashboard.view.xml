<mvc:View
    controllerName="jit.risk.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    displayBlock="true">
    <l:VerticalLayout class="sapUiContentPadding" width="100%">
        
        <!-- Risk Distribution Section -->
        <Panel headerText="Risk Distribution" class="sapUiResponsiveMargin">
            <content>
                <l:HorizontalLayout class="sapUiContentPadding">
                    <l:VerticalLayout class="sapUiSmallMarginEnd">
                        <Title text="Green" level="H3" class="sapUiTinyMarginBottom" titleStyle="H3"/>
                        <ObjectNumber
                            number="{dashboardModel>/green_count}"
                            unit="POs"
                            state="Success"
                            emphasized="true"/>
                        <Text text="{dashboardModel>/green_pct}%" class="sapUiTinyMarginTop"/>
                    </l:VerticalLayout>
                    
                    <l:VerticalLayout class="sapUiSmallMarginEnd">
                        <Title text="Amber" level="H3" class="sapUiTinyMarginBottom" titleStyle="H3"/>
                        <ObjectNumber
                            number="{dashboardModel>/amber_count}"
                            unit="POs"
                            state="Warning"
                            emphasized="true"/>
                        <Text text="{dashboardModel>/amber_pct}%" class="sapUiTinyMarginTop"/>
                    </l:VerticalLayout>
                    
                    <l:VerticalLayout class="sapUiSmallMarginEnd">
                        <Title text="Red" level="H3" class="sapUiTinyMarginBottom" titleStyle="H3"/>
                        <ObjectNumber
                            number="{dashboardModel>/red_count}"
                            unit="POs"
                            state="Error"
                            emphasized="true"/>
                        <Text text="{dashboardModel>/red_pct}%" class="sapUiTinyMarginTop"/>
                    </l:VerticalLayout>
                </l:HorizontalLayout>
                
                <l:HorizontalLayout class="sapUiSmallMarginTop sapUiContentPadding">
                    <l:VerticalLayout class="sapUiSmallMarginEnd">
                        <Label text="Total POs:"/>
                        <Text text="{dashboardModel>/total_pos}" class="sapUiTinyMarginTop"/>
                    </l:VerticalLayout>
                    <l:VerticalLayout class="sapUiSmallMarginBegin">
                        <Label text="Average Delay:"/>
                        <Text text="{dashboardModel>/avg_delay_days} days" class="sapUiTinyMarginTop"/>
                    </l:VerticalLayout>
                </l:HorizontalLayout>
            </content>
        </Panel>

        <!-- Vendor Performance Table -->
        <Panel headerText="Vendor Performance" class="sapUiResponsiveMargin">
            <Table
                id="vendorTable"
                items="{dashboardModel>/vendor_stats}"
                growing="true"
                growingThreshold="20">
                <columns>
                    <Column width="20%">
                        <Text text="Vendor ID"/>
                    </Column>
                    <Column width="20%">
                        <Text text="Country"/>
                    </Column>
                    <Column width="20%">
                        <Text text="OTIF %"/>
                    </Column>
                    <Column width="20%">
                        <Text text="Avg Delay (days)"/>
                    </Column>
                    <Column width="20%">
                        <Text text="PO Count"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{dashboardModel>vendor_id}"/>
                            <Text text="{dashboardModel>country}"/>
                            <ObjectNumber
                                number="{dashboardModel>otif_percent}"
                                unit="%"
                                state="{= ${dashboardModel>otif_percent} >= 95 ? 'Success' : ${dashboardModel>otif_percent} >= 85 ? 'Warning' : 'Error' }"/>
                            <ObjectNumber
                                number="{dashboardModel>avg_delay_days}"
                                state="{= ${dashboardModel>avg_delay_days} &lt; 1 ? 'Success' : ${dashboardModel>avg_delay_days} &lt;= 3 ? 'Warning' : 'Error' }"/>
                            <Text text="{dashboardModel>po_count}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

    </l:VerticalLayout>
</mvc:View>
