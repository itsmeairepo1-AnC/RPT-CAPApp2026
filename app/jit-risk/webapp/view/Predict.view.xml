<mvc:View
    controllerName="jit.risk.controller.Predict"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    displayBlock="true">
    <l:VerticalLayout class="sapUiContentPadding" width="100%">
        
        <!-- Input Form -->
        <Panel headerText="New Purchase Order" class="sapUiResponsiveMargin">
            <content>
                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="3"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="4"
                    emptySpanL="4"
                    emptySpanM="4"
                    emptySpanS="0"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="false">
                    <f:content>
                        <Label text="Vendor"/>
                        <ComboBox
                            id="vendorSelect"
                            items="{vendorModel>/vendors}"
                            selectedKey="{predictionModel>/vendor_id}"
                            change=".onVendorChange">
                            <core:Item key="{vendorModel>vendor_id}" text="{vendorModel>vendor_id} ({vendorModel>country})"/>
                        </ComboBox>
                        
                        <Label text="Material"/>
                        <ComboBox
                            id="materialSelect"
                            items="{materialModel>/materials}"
                            selectedKey="{predictionModel>/material_id}"
                            change=".onMaterialChange">
                            <core:Item key="{materialModel>material_id}" text="{materialModel>material_id} - {materialModel>material_group}"/>
                        </ComboBox>
                        
                        <Label text="Quantity"/>
                        <Input
                            type="Number"
                            value="{predictionModel>/order_quantity}"/>
                        
                        <Label text="Order Month"/>
                        <ComboBox
                            id="orderMonthSelect"
                            selectedKey="{predictionModel>/order_month}"
                            change=".onOrderMonthChange"
                            valueState="{predictionModel>/orderMonthState}"
                            valueStateText="{predictionModel>/orderMonthStateText}">
                            <core:Item key="1" text="January"/>
                            <core:Item key="2" text="February"/>
                            <core:Item key="3" text="March"/>
                            <core:Item key="4" text="April"/>
                            <core:Item key="5" text="May"/>
                            <core:Item key="6" text="June"/>
                            <core:Item key="7" text="July"/>
                            <core:Item key="8" text="August"/>
                            <core:Item key="9" text="September"/>
                            <core:Item key="10" text="October"/>
                            <core:Item key="11" text="November"/>
                            <core:Item key="12" text="December"/>
                        </ComboBox>
                        
                        <Label text="Plant ID"/>
                        <Input value="{predictionModel>/plant_id}"/>
                        
                        <Label text="Incoterms"/>
                        <ComboBox selectedKey="{predictionModel>/incoterms}">
                            <core:Item key="FOB" text="FOB"/>
                            <core:Item key="CIF" text="CIF"/>
                            <core:Item key="EXW" text="EXW"/>
                        </ComboBox>
                    </f:content>
                </f:SimpleForm>
                
                <Toolbar>
                    <ToolbarSpacer/>
                    <Button
                        text="Run Prediction"
                        type="Emphasized"
                        press=".onRunPrediction"/>
                </Toolbar>
            </content>
        </Panel>

        <!-- Prediction Result -->
        <Panel
            headerText="Prediction Result"
            class="sapUiResponsiveMargin"
            visible="{predictionModel>/resultVisible}">
            <content>
                <l:HorizontalLayout class="sapUiContentPadding">
                    <l:VerticalLayout class="sapUiSmallMarginEnd">
                        <Label text="Predicted Delay"/>
                        <ObjectNumber
                            number="{predictionModel>/predicted_delay_days}"
                            unit="days"
                            emphasized="true"/>
                    </l:VerticalLayout>
                    
                    <l:VerticalLayout class="sapUiSmallMarginBegin">
                        <Label text="Risk Tier"/>
                        <ObjectStatus
                            text="{predictionModel>/risk_tier}"
                            state="{= ${predictionModel>/risk_tier} === 'Green' ? 'Success' : ${predictionModel>/risk_tier} === 'Amber' ? 'Warning' : 'Error' }"/>
                    </l:VerticalLayout>
                    
                    <l:VerticalLayout class="sapUiSmallMarginBegin">
                        <Label text="Action Level"/>
                        <ObjectStatus text="{predictionModel>/action_level}"/>
                    </l:VerticalLayout>
                </l:HorizontalLayout>
                
                <Text
                    text="{predictionModel>/recommendation}"
                    class="sapUiSmallMarginTop sapUiSmallMarginBegin"/>
            </content>
        </Panel>

        <!-- Mitigation Proposal -->
        <Panel
            headerText="Mitigation Proposal"
            class="sapUiResponsiveMargin"
            visible="{predictionModel>/mitigationVisible}">
            <content>
                <l:VerticalLayout class="sapUiContentPadding">
                    <Label text="Recommended Alternative Supplier"/>
                    <Text text="{predictionModel>/mitigation/recommended_vendor} ({predictionModel>/mitigation/recommended_country})"/>
                    
                    <l:HorizontalLayout class="sapUiSmallMarginTop">
                        <l:VerticalLayout class="sapUiSmallMarginEnd">
                            <Label text="Lead Time"/>
                            <Text text="{predictionModel>/mitigation/recommended_lead_time} days"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout class="sapUiSmallMarginBegin">
                            <Label text="Unit Price"/>
                            <ObjectNumber
                                number="{predictionModel>/mitigation/recommended_unit_price}"
                                unit="USD"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout class="sapUiSmallMarginBegin">
                            <Label text="Available Stock"/>
                            <ObjectNumber
                                number="{predictionModel>/mitigation/recommended_stock}"
                                state="{= ${predictionModel>/mitigation/can_fulfill} ? 'Success' : 'Error' }"/>
                        </l:VerticalLayout>
                    </l:HorizontalLayout>
                    
                    <l:HorizontalLayout class="sapUiSmallMarginTop">
                        <l:VerticalLayout class="sapUiSmallMarginEnd">
                            <Label text="Price Premium"/>
                            <ObjectNumber
                                number="{predictionModel>/mitigation/price_premium}"
                                unit="USD"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout class="sapUiSmallMarginBegin">
                            <Label text="Net Benefit"/>
                            <ObjectNumber
                                number="{predictionModel>/mitigation/net_benefit}"
                                unit="USD"
                                state="{= ${predictionModel>/mitigation/net_benefit} > 0 ? 'Success' : 'Error' }"/>
                        </l:VerticalLayout>
                    </l:HorizontalLayout>
                    
                    <Toolbar class="sapUiSmallMarginTop">
                        <ToolbarSpacer/>
                        <Button
                            text="Approve"
                            type="Accept"
                            press=".onApproveMitigation"/>
                        <Button
                            text="Reject"
                            type="Reject"
                            press=".onRejectMitigation"/>
                    </Toolbar>
                </l:VerticalLayout>
            </content>
        </Panel>

    </l:VerticalLayout>
</mvc:View>
