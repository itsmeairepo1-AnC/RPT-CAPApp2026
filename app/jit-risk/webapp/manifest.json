{
  "_version": "1.58.0",
  "sap.app": {
    "id": "jit.risk",
    "type": "application",
    "title": "JIT Supply Chain Risk",
    "description": "Just-In-Time supply chain risk assessment using SAP-RPT-1",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/jit-risk/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "jit.risk.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "vendorModel":     { "type": "sap.ui.model.json.JSONModel" },
      "materialModel":   { "type": "sap.ui.model.json.JSONModel" },
      "predictionModel": { "type": "sap.ui.model.json.JSONModel" },
      "dashboardModel":  { "type": "sap.ui.model.json.JSONModel" },
      "chatModel":       { "type": "sap.ui.model.json.JSONModel" }
    }
  }
}
